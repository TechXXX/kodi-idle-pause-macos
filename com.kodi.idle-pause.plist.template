<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kodi.idle-pause</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/Library/Application Support/Kodi Idle Pause/kodi_idle_pause.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/kodi-idle-pause.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/kodi-idle-pause.stderr.log</string>
</dict>
</plist>
